{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "agent/**/*.ts"
  ],
  "exclude": [
    "apps/**",
    ".next/**",
    "node_modules/**",
    "agent/tools/**/*.test.ts"
  ]
}
